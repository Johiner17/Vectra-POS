# Configuración del Servidor
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Seguridad
JWT_SECRET=CAMBIAR_ESTE_SECRET_EN_PRODUCCION_POR_UNO_ALEATORIO_LARGO
JWT_EXPIRES_IN=24h
